<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_secondary"
    android:paddingTop="?attr/actionBarSize"
    tools:context=".ui.today.TodayFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/daily_activity_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@color/design_default_color_secondary_variant"
            app:cardCornerRadius="25dp"
            app:contentPadding="20dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_height="400dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-25dp"
            android:layout_marginTop="-25dp"
            android:contentDescription="@string/today_start_workout_button"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/daily_activity_container"
            app:layout_constraintTop_toBottomOf="@id/daily_activity_container"
            tools:src="@drawable/ink_marker"
            tools:visibility="visible" />

        <androidx.cardview.widget.CardView
            android:id="@+id/week_progress_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@color/design_default_color_secondary_variant"
            app:cardCornerRadius="25dp"
            app:contentPadding="20dp"
            app:layout_constraintTop_toBottomOf="@id/fab">

            <TextView
                android:id="@+id/week_progress_message"
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                tools:text="You are on week 4 of 6." />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
