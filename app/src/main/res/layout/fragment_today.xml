<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_secondary"
    android:paddingTop="?attr/actionBarSize"
    tools:context=".ui.today.TodayFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/daily_activity_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@color/design_default_color_secondary_variant"
            app:cardCornerRadius="25dp"
            app:contentPadding="20dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_height="200dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-25dp"
            android:layout_marginTop="-25dp"
            android:contentDescription="@string/today_start_workout_button"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/daily_activity_container"
            app:layout_constraintTop_toBottomOf="@id/daily_activity_container"
            tools:src="@drawable/ink_marker"
            tools:visibility="visible" />

        <androidx.cardview.widget.CardView
            android:id="@+id/week_progress_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@color/design_default_color_secondary_variant"
            android:visibility="gone"
            app:cardCornerRadius="25dp"
            app:contentPadding="20dp"
            app:layout_constraintTop_toBottomOf="@id/fab"
            tools:visibility="visible">

            <TextView
                android:id="@+id/week_progress_message"
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="25dp"
                tools:text="You are on week 4 of 6." />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:indeterminate="false" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/last_test_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@color/design_default_color_secondary_variant"
            android:visibility="gone"
            app:cardCornerRadius="25dp"
            app:contentPadding="20dp"
            app:layout_constraintTop_toBottomOf="@id/week_progress_card"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/illustration"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:alpha="0.25"
                    android:contentDescription="@null"
                    android:src="@drawable/note"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/last_test_date"
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:layout_constraintEnd_toStartOf="@id/illustration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="September 8, 1910" />

                <TextView
                    android:id="@+id/last_test_message"
                    style="@style/TextAppearance.AppCompat.Subhead"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    app:layout_constraintEnd_toStartOf="@id/illustration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/last_test_date"
                    tools:text="Your last test value was 16." />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
