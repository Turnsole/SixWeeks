<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp">

    <TextView
        android:id="@+id/workout_header"
        style="@style/TextAppearance.AppCompat.Display1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/today_workout_header" />

    <TextView
        android:id="@+id/workout_sets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lines="1"
        app:layout_constraintTop_toBottomOf="@id/workout_header"
        tools:text="Rest: 45 seconds. 12, 12, 13, 13, 14, 21, 21, 45, 67, 90, 90, 90, 90, 90" />

</androidx.constraintlayout.widget.ConstraintLayout>
